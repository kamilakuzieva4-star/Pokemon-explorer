<%- include("partials/header") %>

<a href="<%= backUrl %>">Back to catalog</a>
<article class="detail">
  <div class="picture detail-picture">
    <% if (pokemon.image) { %>
      <img src="<%= pokemon.image %>" alt="<%= pokemon.label %>" width="280" height="280">
    <% } else { %>
      <span>Image unavailable</span>
    <% } %>
  </div>
  <div>
    <p class="number">#<%= pokemon.number %></p>
    <h1 class="detail-name"><%= pokemon.label %></h1>
    <p class="type"><%= pokemon.types || "Unknown type" %></p>
    <dl class="facts">
      <div><dt>Height</dt><dd><%= pokemon.height === null ? "Unknown" : `${pokemon.height} m` %></dd></div>
      <div><dt>Weight</dt><dd><%= pokemon.weight === null ? "Unknown" : `${pokemon.weight} kg` %></dd></div>
      <div><dt>HP</dt><dd><%= pokemon.hp ?? "Unknown" %></dd></div>
      <div><dt>Attack</dt><dd><%= pokemon.attack ?? "Unknown" %></dd></div>
      <div><dt>Speed</dt><dd><%= pokemon.speed ?? "Unknown" %></dd></div>
    </dl>
  </div>
</article>

<%- include("partials/footer") %>
